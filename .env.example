# Model Translation Gateway - Environment Configuration
# Copy this file to .env and fill in your values

################################################################################
# SERVER CONFIGURATION
################################################################################
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

################################################################################
# DATABASE (MongoDB)
################################################################################
MONGODB_URI=mongodb://localhost:27017/gateway
MONGODB_URI_TEST=mongodb://localhost:27017/gateway_test

################################################################################
# ENCRYPTION & JWT
################################################################################
# Generate with: npm run cli -- generate-key
# Must be 32 bytes base64 encoded (44 chars)
ENCRYPTION_KEY=

# JWT Secrets (min 32 characters each)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

################################################################################
# OAUTH PROVIDERS (Google & GitHub)
################################################################################
# Get from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Get from GitHub Developer Settings: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth redirect URI (must match provider configuration)
OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback

################################################################################
# DASHBOARD
################################################################################
DASHBOARD_URL=http://localhost:5173

################################################################################
# PYTHON ROUTER (Optional - Advanced Routing)
################################################################################
PYTHON_ROUTER_URL=http://localhost:8000
PYTHON_ROUTER_ENABLED=false

################################################################################
# LOGGING
################################################################################
LOG_LEVEL=debug
LOG_FORMAT=pretty

################################################################################
# ADMIN (Comma-separated emails for admin access)
################################################################################
ADMIN_EMAILS=

################################################################################
# EXAMPLE PRODUCTION VALUES (DO NOT USE IN PRODUCTION)
################################################################################
# NODE_ENV=production
# MONGODB_URI=mongodb://user:pass@mongodb:27017/gateway?authSource=admin
# ENCRYPTION_KEY=generate-with-cli
# JWT_SECRET=super-secret-production-key-min-32-chars
# JWT_REFRESH_SECRET=super-secret-refresh-key-min-32-chars
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
# OAUTH_REDIRECT_URI=https://yourdomain.com/api/auth/callback
# DASHBOARD_URL=https://yourdomain.com
# PYTHON_ROUTER_URL=http://python-router:8000
# PYTHON_ROUTER_ENABLED=true
# LOG_LEVEL=info
# LOG_FORMAT=json
# ADMIN_EMAILS=admin@yourdomain.com,another@yourdomain.com